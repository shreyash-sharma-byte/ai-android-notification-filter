<!--
  Adaptive foreground, 108x108 with the 72dp safe zone centred.

  A bell with a funnel inside it. The bell is the notification; the funnel is what happens to it.
  Two shapes, two colours, no strokes or gradients, so it stays legible at 48dp — a plain bell reads
  as "notifications" and a plain funnel reads as "filter", and this says both in one silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bell -->
    <path
        android:fillColor="#F4EDE0"
        android:pathData="M54,23c-8.6,0 -15,6.6 -15,15.4v8.6l-5,7c-1,1.4 0,3.4 1.8,3.4h36.4c1.8,0 2.8,-2 1.8,-3.4l-5,-7V38.4C69,29.6 62.6,23 54,23z" />

    <!-- Funnel -->
    <path
        android:fillColor="#E4572E"
        android:pathData="M43,36h22l-8,12.4v7.6h-6v-7.6z" />
</vector>
